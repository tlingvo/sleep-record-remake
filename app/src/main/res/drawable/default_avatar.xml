<?xml version="1.0" encoding="utf-8"?>
<!-- Default role avatar: soft indigo night disc, a calm head-and-shoulders silhouette and a small crescent.
     Vector so it stays crisp at every avatar size and in both themes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <path android:pathData="M48,0a48,48 0,1 1,0 96a48,48 0,1 1,0 -96z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14"
                android:startY="6"
                android:endX="84"
                android:endY="92">
                <item android:offset="0" android:color="#FF9AA8FF" />
                <item android:offset="0.55" android:color="#FF6E7BE6" />
                <item android:offset="1" android:color="#FF4A55B8" />
            </gradient>
        </aapt:attr>
    </path>
    <group>
        <clip-path android:pathData="M48,0a48,48 0,1 1,0 96a48,48 0,1 1,0 -96z" />
        <!-- shoulders -->
        <path
            android:fillColor="#F2F4FF"
            android:fillAlpha="0.92"
            android:pathData="M16,98C16,76.5 30.5,63 48,63C65.5,63 80,76.5 80,98Z" />
        <!-- collar shadow keeps the head and body reading as separate shapes -->
        <path
            android:fillColor="#4A55B8"
            android:fillAlpha="0.22"
            android:pathData="M38,64.5C41,67.5 44.5,69 48,69C51.5,69 55,67.5 58,64.5C55,63.5 51.6,63 48,63C44.4,63 41,63.5 38,64.5Z" />
    </group>
    <!-- head -->
    <path
        android:fillColor="#F2F4FF"
        android:fillAlpha="0.95"
        android:pathData="M48,25a15.5,15.5 0,1 1,0 31a15.5,15.5 0,1 1,0 -31z" />
    <!-- crescent -->
    <path
        android:fillColor="#FFF3C8"
        android:pathData="M72.6,15.2a9,9 0,1 0,7.4 13.4a7,7 0,1 1,-7.4 -13.4z" />
    <!-- stars -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M22,22l1.2,2.8l2.8,1.2l-2.8,1.2l-1.2,2.8l-1.2,-2.8l-2.8,-1.2l2.8,-1.2z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.6"
        android:pathData="M30,12.5l0.8,1.7l1.7,0.8l-1.7,0.8l-0.8,1.7l-0.8,-1.7l-1.7,-0.8l1.7,-0.8z" />
</vector>
